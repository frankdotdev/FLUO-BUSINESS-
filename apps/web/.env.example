# Copy to .env.local (never commit). Every REQUIRED value is checked at startup with a clear error.
# --- required ---
DATABASE_URL=postgres://user:password@host:6543/postgres      # POOLED connection string for the app
APP_URL=http://localhost:3000                                 # public base URL, no trailing slash
BETTER_AUTH_SECRET=                                           # openssl rand -base64 32
FIELD_ENCRYPTION_KEYS=k1=                                     # k1=<base64 of 32 random bytes>: openssl rand -base64 32 ; first key is active, add k0=... when rotating
TICKET_HMAC_SECRET=                                           # openssl rand -base64 32
PAYSTACK_SECRET_KEY=sk_test_...
CRON_SECRET=                                                  # openssl rand -base64 32 ; the scheduler sends it as a Bearer token
# --- email: Resend is used when RESEND_API_KEY is set, otherwise Gmail SMTP ---
EMAIL_FROM=Fluo <you@yourdomain.com>
RESEND_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=                                           # a Google "app password" (needs 2-step verification), not your login password
# --- optional ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EXPO_ACCESS_TOKEN=
EVENT_FEE_BPS=200                                             # 200 = 2% on paid event tickets
# --- media (product photos, event covers, logos). Leave all five empty to switch uploads off; set all five to switch them on ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=                                         # an R2 API token limited to this one bucket (Object Read & Write)
R2_BUCKET=fluo-public
R2_PUBLIC_BASE_URL=https://media.yourdomain.com               # the bucket's public custom domain, no trailing slash
